www.enyagasambu.rw {
  redir https://enyagasambu.rw{uri} permanent
}

enyagasambu.rw {
  encode zstd gzip

  # Upstream pool of backend API instances. Caddy load-balances across them
  # with the default round-robin policy and marks unhealthy instances down
  # via active health checks on /api/health.
  upstream_backend {
    backend:5000
    # Add additional backend instances here for horizontal scaling:
    # backend-2:5000
    # backend-3:5000
    active_health_check {
      uri /api/health
      interval 5s
      timeout 2s
    }
  }

  @api path /api/*
  handle @api {
    reverse_proxy upstream_backend {
      header_up Host {upstream_hostport}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  handle {
    reverse_proxy frontend:3000
  }

  header {
    X-Frame-Options "SAMEORIGIN"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    X-XSS-Protection "1; mode=block"
  }

  log {
    output stdout
    format json
  }
}
