# Copy this file to .env and fill in real values. NEVER commit .env.

# Server
PORT=5000
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database (mysql2)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=nmo_db
DB_POOL_LIMIT=10

# Auth
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=7d

# SMTP (optional, used for email notifications / password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=app_password
SMTP_FROM="E-Nyagasambu <you@gmail.com>"

# Africa's Talking SMS
AT_USERNAME=YOUR_AT_USERNAME
AT_API_KEY=atsk_xxxxx
AT_SENDER_ID=NMO

# MTN MoMo
MOMO_SUBSCRIPTION_KEY=xxxx
MOMO_USER_ID=
MOMO_API_KEY=
MOMO_ENV=production
MOMO_COLLECTION_BASE=https://proxy.momoapi.mtn.com
MOMO_PROVISION_BASE=https://proxy.momoapi.mtn.com

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nmo-images
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/nmo-images

# NODE_ENV=development | test | production
NODE_ENV=development