# Database
MYSQL_ROOT_PASSWORD=change_me_in_production
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me_in_production
DB_NAME=nmo_db

# JWT
JWT_SECRET=generate_a_64_char_random_string_for_production
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=https://enyagasambu.rw,https://www.enyagasambu.rw
FRONTEND_URL=https://enyagasambu.rw

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="E-Nyagasambu <noreply@enyagasambu.rw>"

# Africa's Talking
AT_API_KEY=your_at_api_key
AT_USERNAME=your_at_username
AT_SENDER_ID=NMO

# MTN MoMo
MOMO_ENV=sandbox
MOMO_SUBSCRIPTION_KEY=your_momo_subscription_key
MOMO_USER_ID=your_momo_user_id
MOMO_API_KEY=your_momo_api_key
MOMO_COLLECTION_BASE=https://proxy.momoapi.mtn.com
MOMO_PROVISION_BASE=https://proxy.momoapi.mtn.com

# S3 / MinIO
S3_ENDPOINT=https://your-s3-endpoint.amazonaws.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com
