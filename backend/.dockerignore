# Never copy host-only dependencies or runtime data into the Linux image.
node_modules/
npm-debug.log*

# Local environment files and secrets are supplied by Docker Compose at runtime.
.env
.env.*
!.env.example

# Local runtime/build artifacts.
uploads/
coverage/
*.log

# Editor and OS metadata.
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db
ca-avast.pem
*.md
