# Database
MYSQL_ROOT_PASSWORD=change_me_in_production
DB_USER=root

# JWT
JWT_SECRET=generate_a_64_char_random_string_for_production
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=https://enyagasambu.rw,https://www.enyagasambu.rw
FRONTEND_URL=https://enyagasambu.rw

# Frontend
NEXT_PUBLIC_API_URL=https://enyagasambu.rw/api
NEXT_PUBLIC_SITE_URL=https://enyagasambu.rw
NEXT_PUBLIC_SITE_DOMAIN=enyagasambu.rw

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="E-Nyagasambu <noreply@enyagasambu.rw>"

# Africa's Talking
AT_API_KEY=your_at_api_key
AT_USERNAME=your_at_username

# MTN MoMo (use sandbox for testing, production for live)
MOMO_ENV=sandbox
MOMO_SUBSCRIPTION_KEY=your_momo_subscription_key
MOMO_USER_ID=your_momo_user_id
MOMO_API_KEY=your_momo_api_key

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
S3_PUBLIC_URL=https://enyagasambu.rw/minio/nmo-images
ENABLE_SCHEDULERS=false

# === Cluster / Load Balancing ===
# Number of Node.js worker processes (defaults to CPU count).
CLUSTER_WORKERS=
# Run background schedulers (expiry, reminders, auctions, payments) in master.
ENABLE_SCHEDULERS=false

# === Production Logging ===
# Set to "true" to write structured JSON logs to disk in addition to stdout.
LOG_TO_FILE=false
# Directory for log files (defaults to backend/logs/).
LOG_DIR=
# Rotate a log file once it exceeds this many megabytes.
LOG_MAX_SIZE_MB=50
# Log queries slower than this many milliseconds (production only).
LOG_SLOW_QUERIES=false
SLOW_QUERY_MS=1000

# === Request / Concurrency Controls ===
# Abort requests taking longer than this many ms (default 30000).
REQUEST_TIMEOUT_MS=30000
# Reject new requests once this many are in flight (0 = disabled).
MAX_CONCURRENT_REQUESTS=0
# Global rate limit: max requests per windowMs per IP.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# === Database Pool Tuning ===
DB_POOL_LIMIT=20
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
