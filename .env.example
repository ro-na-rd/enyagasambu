# Database
MYSQL_ROOT_PASSWORD=change_me_in_production
DB_USER=root

# JWT
JWT_SECRET=generate_a_64_char_random_string_for_production
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=https://enyagasambu.rw,https://www.enyagasambu.rw
FRONTEND_URL=https://enyagasambu.rw

# Frontend
NEXT_PUBLIC_API_URL=https://enyagasambu.rw/api
NEXT_PUBLIC_SITE_URL=https://enyagasambu.rw
NEXT_PUBLIC_SITE_DOMAIN=enyagasambu.rw

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="E-Nyagasambu <noreply@enyagasambu.rw>"

# Africa's Talking
AT_API_KEY=your_at_api_key
AT_USERNAME=your_at_username

# MTN MoMo (use sandbox for testing, production for live)
MOMO_ENV=sandbox
MOMO_SUBSCRIPTION_KEY=your_momo_subscription_key
MOMO_USER_ID=your_momo_user_id
MOMO_API_KEY=your_momo_api_key

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
S3_PUBLIC_URL=https://enyagasambu.rw/minio/nmo-images
