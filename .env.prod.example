# Production env — copy to .env and fill with real secrets
# Generate JWT: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
MYSQL_ROOT_PASSWORD=change_to_strong_32_char_random
MINIO_ROOT_USER=minioadmin_prod
MINIO_ROOT_PASSWORD=change_to_strong_minio_password_32char
JWT_SECRET=change_to_64_char_hex_random_string_min_32_chars
JWT_EXPIRES_IN=7d

CLIENT_URL=https://enyagasambu.rw,https://www.enyagasambu.rw
FRONTEND_URL=https://enyagasambu.rw
NEXT_PUBLIC_API_URL=https://enyagasambu.rw/api
NEXT_PUBLIC_SITE_URL=https://enyagasambu.rw
S3_PUBLIC_URL=https://enyagasambu.rw/minio/nmo-images
# Or use AWS S3:
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_BUCKET=nmo-images-prod
# S3_REGION=eu-central-1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@enyagasambu.rw
SMTP_PASS=your_app_password_not_real_password
SMTP_FROM="E-Nyagasambu <noreply@enyagasambu.rw>"

AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key
MOMO_SUBSCRIPTION_KEY=your_momo_key
MOMO_USER_ID=your_momo_user_uuid
MOMO_API_KEY=your_momo_api_key
